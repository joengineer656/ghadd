{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghadd",
  "version": "0.1.0",
  "identifier": "io.github.ghadd",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ghadd",
        "width": 1000,
        "height": 780,
        "minWidth": 420,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Lifestyle",
    "shortDescription": "Website blocker, streak tracker and Islamic reminders",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
